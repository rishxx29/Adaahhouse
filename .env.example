# ==============================================================================
# HOUSE OF RII — Production Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file or private secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain from: https://app.supabase.com/project/_/settings/api
# Frontend Public Credentials (Exposed to client for Auth & Realtime):
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key"

# Backend Server Secret Credentials (NEVER exposed to frontend, used on server only):
# Used for administrative provisioning, atomic row-level security bypass, and secure queries.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (UPI, Cards, Netbanking)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/app/keys
# Key ID (Public key for checkout modal):
VITE_RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_ID="rzp_test_yourKeyId"

# Key Secret (Server-side HMAC-SHA256 signature verification & order creation):
# KEEP THIS STRICTLY SECRET ON SERVER:
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Webhook Secret (Validating incoming payment webhooks from Razorpay):
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 3. FIRST ADMINISTRATOR SETUP & PROVISIONING
# ------------------------------------------------------------------------------
# A secure token used once to promote your registered user to 'admin' role
# via the endpoint POST /api/admin/setup-first-admin or Studio Settings tab:
ADMIN_SETUP_SECRET="change-this-to-a-secure-random-secret-key-32chars"

# ------------------------------------------------------------------------------
# 4. OFFICIAL BOUTIQUE EMAIL & NOTIFICATIONS (Gmail SMTP)
# ------------------------------------------------------------------------------
# Official boutique inbox receiving all order alerts:
OWNER_EMAIL="houseofrii29@gmail.com"

# To dispatch automated order confirmation receipts via Gmail SMTP:
# 1. Enable 2-Step Verification on houseofrii29@gmail.com
# 2. Visit https://myaccount.google.com/apppasswords
# 3. Create an App Name like "House of Rii Website" and generate a 16-character password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="houseofrii29@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
